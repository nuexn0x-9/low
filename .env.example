# ==============================================================================
# LOW (Lowcode Oriented Wireframe) — Environment Configuration Template
# Copy this file to '.env' before running locally or via Docker Compose:
#   cp .env.example .env
# ==============================================================================

# Application Environment: 'development' or 'production'
APP_NAME=LOW
APP_ENV=development

# Database URL
# For local development: sqlite+aiosqlite:///./low.db
# For Docker Compose: sqlite+aiosqlite:////app/data/low.db
DATABASE_URL=sqlite+aiosqlite:///./low.db

# Asset Storage Directory
# For local development: ./storage/assets
# For Docker Compose: /app/data/uploads
ASSET_STORAGE_PATH=./storage/assets

# Security & Authentication
# IMPORTANT: Generate a strong random 32+ character key in production!
# e.g., python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=low-dev-secret-key-change-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (comma separated or * for all)
CORS_ORIGINS=*

# Agent Connect Configuration
AGENT_SESSION_EXPIRE_MINUTES=1440
ALLOW_DEV_LOCAL_USER=true

# AI Import Engine Configuration
# Supported providers: 'mock' (offline zero-cost, default) or 'openai'
AI_PROVIDER=mock

# OpenAI API Key (Only required if AI_PROVIDER=openai)
OPENAI_API_KEY=

# OpenAI Model configuration
AI_MODEL=gpt-4o-mini
AI_MAX_OUTPUT_TOKENS=4000
AI_REQUEST_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=2

# Frontend Configuration (Used during React build)
REACT_APP_BACKEND_URL=http://localhost:8000
